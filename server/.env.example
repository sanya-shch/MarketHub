# Matches docker-compose.yml in the repo root (`yarn db:up`).
DATABASE_URL="postgresql://markethub:markethub@localhost:5432/markethub?schema=public"

# Use two DIFFERENT long random strings (e.g. `openssl rand -base64 48`).
# The server refuses to start if JWT_REFRESH_SECRET is missing or equals JWT_SECRET.
JWT_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5001
SERVER_DOMAIN=localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integration tests (`yarn db:test:up`)
# DATABASE_URL_TEST="postgresql://markethub:markethub@localhost:5433/markethub_test?schema=public"
